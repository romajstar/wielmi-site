# Public values are embedded in the static build. Enable only for production.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_ENABLE_TEST_ERROR_PAGE=false

# Build-only source map upload credentials; never prefix these with NEXT_PUBLIC_.
POSTHOG_SOURCEMAPS_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
